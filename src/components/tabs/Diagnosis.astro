---
import { getCollection } from 'astro:content';
import { projectGroups, projectRows } from '../../lib/project-publication.mjs';
import type { RepositoryMetadata } from '../../lib/project-publication.mjs';

// Only authored cases are published. GitHub enriches metadata, never inclusion.
const projects = await getCollection('projects');
let repositories: RepositoryMetadata[] = [];
if (process.env.PORTFOLIO_OFFLINE !== '1') {
  try {
    const response = await fetch('https://api.github.com/users/ppeck1/repos?per_page=100', {
      signal: AbortSignal.timeout(8000),
    });
    if (!response.ok) throw new Error(`GitHub metadata: ${response.status}`);
    const result = await response.json();
    repositories = Array.isArray(result) ? result : [];
  } catch (error) {
    console.warn('[Projects] Optional GitHub metadata unavailable; using authored cases.');
  }
}
const rows = projectRows(projects, repositories);
const selected = rows.filter((row) => row.group === 'selected');
const supportingGroups = projectGroups.filter((group) => group.key !== 'selected');
---

<div class="tab-panel" id="panel-diagnosis">
  <h2>Diagnosis - Projects and Working Evidence</h2>
  <p class="intro">Tools shaped by clinical workflow, local ownership, and human review. Start with the selected work, then explore the research and creative projects behind it.</p>

  <section class="pinned-section" aria-labelledby="pinned-heading">
    <h3 id="pinned-heading">Selected Work</h3>
    <div class="projects-grid">
      {selected.map((row) => (
        <article class="project-card">
          {row.image && <a href={row.writeupUrl} class="project-image-link" aria-label={`Open ${row.title}`}>
            <img src={row.image} alt={row.imageAlt} loading="lazy" />
          </a>}
          <div class="project-card-body">
            <h4><a href={row.writeupUrl}>{row.title}</a></h4>
            <p>{row.description}</p>
            <div class="tag-pills">{row.tags.map((tag) => <span class="tag-pill">{tag}</span>)}</div>
            <div class="project-actions">
              <a href={row.writeupUrl} class="github-link">Open full case -&gt;</a>
              {row.githubUrl && <a href={row.githubUrl} class="github-link" target="_blank" rel="noopener">GitHub -&gt;</a>}
              {row.demoUrl && <a href={row.demoUrl} class="github-link" target="_blank" rel="noopener">{row.demoLinkLabel} -&gt;</a>}
            </div>
          </div>
          <span class={`status-badge status-${row.status}`}>{row.status}</span>
        </article>
      ))}
    </div>
  </section>

  <p class="sync-note">A selected collection of working tools, research, and creative projects.</p>
  {supportingGroups.map((group) => (
    <section class="problem-list-section" aria-labelledby={`group-${group.key}`}>
      <div class="problem-list-head"><h3 id={`group-${group.key}`}>{group.title}</h3></div>
      <div class="repo-rows">
        {rows.filter((row) => row.group === group.key).map((row) => (
          <details class="repo-row">
            <summary>
              <span class="row-glyph" aria-hidden="true"></span>
              <span class={`row-dot dot-${row.status}`} aria-hidden="true">●</span>
              <span class="row-title">{row.title}</span>
              <span class="row-meta">{row.language}{row.pushed && ` · upd ${row.pushed}`}</span>
            </summary>
            <div class="row-body">
              {row.image && <a href={row.writeupUrl} class="row-shot" aria-label={`Open ${row.title}`}>
                <img src={row.image} alt={row.imageAlt} loading="lazy" decoding="async" />
              </a>}
              <p>{row.description}</p>
              <div class="tag-pills">{row.tags.map((tag) => <span class="tag-pill">{tag}</span>)}</div>
              <div class="row-links">
                <a href={row.writeupUrl}>Open full case -&gt;</a>
                {row.githubUrl && <a href={row.githubUrl} target="_blank" rel="noopener">GitHub -&gt;</a>}
                {row.demoUrl && <a href={row.demoUrl} target="_blank" rel="noopener">{row.demoLinkLabel} -&gt;</a>}
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .intro {
    margin: 1.5rem 0;
    font-size: 1.05rem;
    color: var(--text-secondary);
  }

  .pinned-section h3,
  .problem-list-head h3 {
    margin: 2rem 0 0.5rem 0;
    font-size: 1.15rem;
  }

  /* ---- Selected Work ---- */

  .projects-grid {
    margin: 1rem 0 2rem 0;
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    overflow: hidden;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    position: relative;
    transition: all 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--color-teal);
    transform: translateY(-2px);
  }

  .project-image-link {
    display: block;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-primary);
  }

  .project-image-link img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .project-card-body {
    padding: 1.5rem;
  }

  .project-card h4 {
    margin: 0 0 0.75rem 0;
    font-size: 1.3rem;
  }

  .project-card h4 a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .project-card h4 a:hover {
    color: var(--color-teal);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .github-link {
    display: inline-flex;
    color: var(--color-teal);
    font-size: 0.9rem;
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .status-active {
    background: var(--color-green);
    color: white;
  }

  .status-completed {
    background: var(--color-teal);
    color: white;
  }

  .status-archived {
    background: var(--border-color);
    color: var(--text-secondary);
  }

  /* ---- Tag pills (shared) ---- */

  .tag-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .tag-pill {
    padding: 0.125rem 0.6rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    font-size: 0.72rem;
    font-family: monospace;
    color: var(--text-secondary);
    background: var(--bg-primary);
    white-space: nowrap;
  }

  /* ---- Full Problem List ---- */

  .problem-list-section {
    margin: 2.5rem 0;
  }

  .problem-list-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .sync-note {
    font-family: monospace;
    font-size: 0.72rem;
    color: var(--text-secondary);
    white-space: normal;
  }

  .repo-rows {
    border-top: 1px solid var(--border-color);
  }

  .repo-row {
    border-bottom: 1px solid var(--border-color);
  }

  .repo-row summary {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.75rem 0.5rem;
    cursor: pointer;
    list-style: none;
  }

  .repo-row summary::-webkit-details-marker {
    display: none;
  }

  .repo-row summary:hover {
    background: var(--bg-secondary);
  }

  .row-glyph {
    flex: 0 0 auto;
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .row-glyph::before {
    content: '▸';
  }

  .repo-row[open] .row-glyph::before {
    content: '▾';
  }

  .row-dot {
    flex: 0 0 auto;
    font-size: 0.7rem;
    line-height: 1;
  }

  .dot-active {
    color: var(--color-green);
  }

  .dot-completed {
    color: var(--color-teal);
  }

  .dot-archived {
    color: var(--text-secondary);
  }

  .dot-unfiled {
    color: var(--color-orange);
  }

  .row-title {
    flex: 1 1 auto;
    min-width: 180px;
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--text-primary);
  }

  .pin-chip {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--color-orange);
    letter-spacing: 0.5px;
    margin-left: 0.625rem;
    text-transform: uppercase;
  }

  .row-meta {
    flex: 0 0 auto;
    font-family: monospace;
    font-size: 0.72rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .row-body {
    padding: 0 0.5rem 1rem 1.875rem;
  }

  .row-shot {
    display: block;
    margin: 0.25rem 0 0.875rem 0;
    max-width: 480px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-primary);
  }

  .row-shot img {
    display: block;
    width: 100%;
    max-height: 240px;
    object-fit: cover;
  }

  .row-body p {
    margin: 0 0 0.625rem 0;
    max-width: 45rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .row-body .tag-pills {
    margin: 0 0 0.75rem 0;
  }

  .row-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: baseline;
  }

  .row-links a {
    color: var(--color-teal);
    font-size: 0.85rem;
    font-family: monospace;
    white-space: nowrap;
  }

  .unfiled-note {
    font-family: monospace;
    font-size: 0.72rem;
    color: var(--color-orange);
    white-space: nowrap;
  }

  .unfiled-legend {
    margin-top: 0.75rem;
    font-family: monospace;
    font-size: 0.72rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .project-image-link img {
      height: 170px;
    }

    .row-meta {
      display: none;
    }
  }
</style>
