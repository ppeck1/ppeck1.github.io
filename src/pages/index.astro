---
// src/pages/index.astro - Main EMR interface
import Layout from '../layouts/Layout.astro';
import IntroSequence from '../components/IntroSequence.astro';
import TabNavigation from '../components/TabNavigation.astro';
import Dock from '../components/Dock.astro';

// Import all tab components
import Demographics from '../components/tabs/Demographics.astro';
import History from '../components/tabs/History.astro';
import Diagnosis from '../components/tabs/Diagnosis.astro';
import Notes from '../components/tabs/Notes.astro';
import Documents from '../components/tabs/Documents.astro';

// Person structured data (home page only)
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Paul Peck',
  honorificSuffix: 'RN',
  jobTitle: 'Healthcare AI Solutions Analyst',
  description:
    'Clinical workflow and governance systems: EHR documentation optimization, AI-assisted workflow design with human review, local-first knowledge systems.',
  url: 'https://ppeck.me',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Columbus',
    addressRegion: 'OH',
    addressCountry: 'US'
  },
  sameAs: [
    'https://www.linkedin.com/in/paul-peck-759737211/',
    'https://github.com/ppeck1'
  ]
};
---

<Layout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personSchema)} />
  <IntroSequence />
  
  <div class="emr-container">
    <TabNavigation />
    
    <div class="tab-panels">
      <Demographics />
      <History />
      <Diagnosis />
      <Notes />
      <Documents />
    </div>
    
    <Dock />
  </div>
</Layout>

<style>
  /* Additional page-specific styles if needed */
  .emr-container {
    padding-bottom: 80px; /* Space for dock */
  }
</style>
