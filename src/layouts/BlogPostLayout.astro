---
// BlogPostLayout.astro - Individual blog post template
import Layout from './Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  image?: string;
  imageAlt?: string;
}

const { title, description, date, tags = [], image, imageAlt } = Astro.props;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC'
  }).format(date);
}

// BlogPosting structured data
const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString().split('T')[0],
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  author: {
    '@type': 'Person',
    name: 'Paul Peck',
    url: 'https://ppeck.me'
  }
};
---

<Layout title={`${title} — Paul Peck, RN | E-MyR`} description={description} image={image} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(postSchema)} />
  <ThemeToggle />

  <div class="blog-post-container">
    <nav class="back-nav">
      <a href="/#notes" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Chart</span>
      </a>
    </nav>

    <article class="blog-post">
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {tags.length > 0 && (
            <div class="tags">
              {tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      {image && (
        <figure class="post-hero">
          <img src={image} alt={imageAlt || `${title} image`} loading="lazy" decoding="async" />
        </figure>
      )}

      <div class="post-content">
        <slot />
      </div>

      <section class="post-comments" aria-label="Comments">
        <h2 class="comments-heading">Comments – Addendum Notes</h2>
        <p class="comments-note">Sign in with GitHub to comment or reply. Comments live as GitHub Discussions on the site repo — no ppeck.me account needed.</p>
        <div id="giscus-container"></div>
      </section>
    </article>
  </div>
</Layout>

<style>
  .blog-post-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 100vh;
  }

  .back-nav {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-teal);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    background: var(--bg-secondary);
    border-color: var(--color-teal);
  }

  .back-link svg {
    width: 20px;
    height: 20px;
  }

  .blog-post {
    background: var(--bg-secondary);
    padding: 3rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border-color);
  }

  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .post-meta time {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .post-hero {
    margin: 0 0 2rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-primary);
  }

  .post-hero img {
    display: block;
    width: 100%;
    max-height: 460px;
    object-fit: contain;
  }

  .post-content {
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .post-content :global(h2) {
    color: var(--color-teal);
    margin: 2.5rem 0 1rem;
    font-size: 1.8rem;
  }

  .post-content :global(h3) {
    color: var(--text-primary);
    margin: 2rem 0 1rem;
    font-size: 1.4rem;
  }

  .post-content :global(h4) {
    margin: 1.5rem 0 0.75rem;
    font-size: 1.2rem;
  }

  .post-content :global(p) {
    margin: 1rem 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1rem 0;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin: 0.5rem 0;
  }

  .post-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .post-content :global(em) {
    font-style: italic;
  }

  .post-content :global(a) {
    color: var(--color-teal);
    text-decoration: underline;
  }

  .post-content :global(a:hover) {
    opacity: 0.8;
  }

  .post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid var(--color-teal);
    background: var(--bg-primary);
    font-style: italic;
  }

  .post-content :global(.media-frame) {
    margin: 2rem 0;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-primary);
  }

  .post-content :global(.media-frame img),
  .post-content :global(.media-frame video) {
    display: block;
    width: 100%;
    height: auto;
  }

  .post-content :global(.video-embed) {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .post-content :global(.video-embed iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .post-content :global(.media-frame figcaption) {
    padding: 0.75rem 1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    border-top: 1px solid var(--border-color);
  }

  .post-content :global(hr) {
    margin: 2rem 0;
    border: none;
    border-top: 2px solid var(--border-color);
  }

  .post-comments {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border-color);
  }

  .comments-heading {
    color: var(--color-teal);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .comments-note {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 768px) {
    .blog-post-container {
      padding: 1rem;
    }

    .blog-post {
      padding: 2rem 1.5rem;
    }

    .post-header h1 {
      font-size: 2rem;
    }

    .post-content {
      font-size: 1rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  const backLink = document.querySelector('.back-link');
  if (backLink) {
    backLink.addEventListener('click', () => {
      localStorage.setItem('emr-last-tab', 'notes');
    });
  }
</script>

<script is:inline>
  (function () {
    // giscus: comments as GitHub Discussions on ppeck1/ppeck1.github.io.
    // Theme follows the site's data-theme attribute (light / dark_dimmed).
    function giscusTheme() {
      return document.documentElement.getAttribute('data-theme') === 'dark'
        ? 'dark_dimmed'
        : 'light';
    }

    const container = document.getElementById('giscus-container');
    if (!container) return;

    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.async = true;
    s.crossOrigin = 'anonymous';
    const attrs = {
      'data-repo': 'ppeck1/ppeck1.github.io',
      'data-repo-id': 'R_kgDOQN6Zbg',
      'data-category': 'Announcements',
      'data-category-id': 'DIC_kwDOQN6Zbs4DAkub',
      'data-mapping': 'pathname',
      'data-strict': '0',
      'data-reactions-enabled': '1',
      'data-emit-metadata': '0',
      'data-input-position': 'bottom',
      'data-theme': giscusTheme(),
      'data-lang': 'en',
      'data-loading': 'lazy',
    };
    for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
    container.appendChild(s);

    // Re-theme the embedded iframe when the site theme toggles.
    new MutationObserver(function () {
      const iframe = document.querySelector('iframe.giscus-frame');
      if (iframe && iframe.contentWindow) {
        iframe.contentWindow.postMessage(
          { giscus: { setConfig: { theme: giscusTheme() } } },
          'https://giscus.app'
        );
      }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>
