---
// BlogPostLayout.astro - Individual blog post template
import Layout from './Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}

const { title, description, date, tags = [] } = Astro.props;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}
---

<Layout title={`${title} — Paul Peck, RN`} description={description}>
  <ThemeToggle />
  
  <div class="blog-post-container">
    <nav class="back-nav">
      <a href="/#notes" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Chart</span>
      </a>
    </nav>

    <article class="blog-post">
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {tags.length > 0 && (
            <div class="tags">
              {tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="post-content">
        <slot />
      </div>
    </article>
  </div>
</Layout>

<style>
  .blog-post-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 100vh;
  }

  .back-nav {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-teal);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    background: var(--bg-secondary);
    border-color: var(--color-teal);
  }

  .back-link svg {
    width: 20px;
    height: 20px;
  }

  .blog-post {
    background: var(--bg-secondary);
    padding: 3rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border-color);
  }

  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .post-meta time {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .post-content {
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .post-content :global(h2) {
    color: var(--color-teal);
    margin: 2.5rem 0 1rem;
    font-size: 1.8rem;
  }

  .post-content :global(h3) {
    color: var(--text-primary);
    margin: 2rem 0 1rem;
    font-size: 1.4rem;
  }

  .post-content :global(h4) {
    margin: 1.5rem 0 0.75rem;
    font-size: 1.2rem;
  }

  .post-content :global(p) {
    margin: 1rem 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1rem 0;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin: 0.5rem 0;
  }

  .post-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .post-content :global(em) {
    font-style: italic;
  }

  .post-content :global(a) {
    color: var(--color-teal);
    text-decoration: underline;
  }

  .post-content :global(a:hover) {
    opacity: 0.8;
  }

  .post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid var(--color-teal);
    background: var(--bg-primary);
    font-style: italic;
  }

  .post-content :global(hr) {
    margin: 2rem 0;
    border: none;
    border-top: 2px solid var(--border-color);
  }

  @media (max-width: 768px) {
    .blog-post-container {
      padding: 1rem;
    }

    .blog-post {
      padding: 2rem 1.5rem;
    }

    .post-header h1 {
      font-size: 2rem;
    }

    .post-content {
      font-size: 1rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  // When returning to chart, activate Notes tab
  const backLink = document.querySelector('.back-link');
  if (backLink) {
    backLink.addEventListener('click', (e) => {
      // Store that we want to open the Notes tab
      localStorage.setItem('emr-last-tab', 'notes');
    });
  }
</script>
